<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<profiles version="21">
  <profile kind="CodeFormatterProfile" name="WhiskyStyle" version="21">
    <!-- Use spaces, not tabs -->
    <setting id="org.eclipse.jdt.core.formatter.tabulation.char" value="space"/>
    <setting id="org.eclipse.jdt.core.formatter.tabulation.size" value="4"/>
    <setting id="org.eclipse.jdt.core.formatter.indentation.size" value="4"/>

    <!-- Max line length before wrapping -->
    <setting id="org.eclipse.jdt.core.formatter.lineSplit" value="144"/>

    <!-- Wrap only when needed, then align parameters nicely -->
    <setting id="org.eclipse.jdt.core.formatter.alignment_for_parameters_in_method_declaration" value="82"/>
    <setting id="org.eclipse.jdt.core.formatter.alignment_for_parameters_in_constructor_declaration" value="82"/>

    <!-- Same rule for method calls -->
    <setting id="org.eclipse.jdt.core.formatter.alignment_for_arguments_in_method_invocation" value="16"/>
    <setting id="org.eclipse.jdt.core.formatter.alignment_for_arguments_in_allocation_expression" value="81"/>

    <!-- Continuation indent -->
    <!-- <setting id="org.eclipse.jdt.core.formatter.continuation_indentation" value="1"/> -->
    <!-- Record components -->
    <setting id="org.eclipse.jdt.core.formatter.alignment_for_record_components" value="49"/>
    <setting id="org.eclipse.jdt.core.formatter.parentheses_positions_in_record_declaration" value="separate_lines_if_wrapped"/>

    <!-- Enum constants -->
    <setting id="org.eclipse.jdt.core.formatter.alignment_for_enum_constants" value="49"/>

    <!-- Preserve intentional manual wrapping -->
    <setting id="org.eclipse.jdt.core.formatter.join_wrapped_lines" value="false"/>
    <setting id="org.eclipse.jdt.core.formatter.preserve_user_linebreaks" value="true"/>

    <!-- When a method call wraps, allow opening/closing parens to sit nicely -->
    <setting id="org.eclipse.jdt.core.formatter.parentheses_positions_in_method_invocation" value="preserve_positions"/>

    <!-- Keep nested method calls from being exploded too aggressively -->
    <setting id="org.eclipse.jdt.core.formatter.wrap_outer_expressions_when_nested" value="true"/>

    <!-- Ternary: force ? and : onto their own lines -->
    <setting id="org.eclipse.jdt.core.formatter.alignment_for_conditional_expression" value="49"/>
    <setting id="org.eclipse.jdt.core.formatter.wrap_before_conditional_operator" value="true"/>

    <!-- Switch: indent case labels one level inside switch -->
    <setting id="org.eclipse.jdt.core.formatter.indent_switchstatements_compare_to_switch" value="true"/>
    <setting id="org.eclipse.jdt.core.formatter.indent_switchstatements_compare_to_cases" value="true"/>
  </profile>
</profiles>